# EZPIPELINE environment.
#
# Copy to .env in this same directory and fill in. apps/server/src/config/index.ts
# loads it at startup, so every change needs a server restart. .env is gitignored
# and must stay that way - several of these are credentials.

# Server - the port the API and the built client are served on. Falls back to
# ports.server in ezpipeline.config.json (5001) when unset.
PORT=5001

# Signing key for login tokens. REQUIRED in any real install: without it the
# server falls back to a hard-coded string that is published in this repository,
# which means anyone can mint a valid admin token. Use a long random value.
JWT_SECRET=replace-with-a-long-random-string

# AI assistant - the key the assistant uses to call the Anthropic API. Without
# it the assistant panel loads and then says it is not configured; nothing else
# in EZPIPELINE is affected. Get one at https://console.anthropic.com/.
# This is read on the server only. It is never sent to the browser, never
# written to a log and never stored in the database, so there is deliberately no
# field in the interface to enter it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override for the assistant. Defaults to claude-opus-5. Set it
# to a smaller model (claude-sonnet-5, claude-haiku-4-5) to trade capability for
# cost, or to pin a specific model through an upgrade.
ANTHROPIC_MODEL=claude-opus-5

# ── Ports ───────────────────────────────────────────────────────────────────
#
# Resolution order, highest first: a real shell variable, then this file, then
# ports.{server,client} in ezpipeline.config.json. scripts/docker.mjs resolves
# them and passes the result to Docker Compose, so a value set here reaches the
# containers; compose's own literals are only a last resort.
#
# Both must differ from each other and be free, or the stack refuses to start
# and names what is holding the port.

# The Docker client (Vite dev server). 5173 rather than 5000: macOS AirPlay
# Receiver holds 5000, which made the stack unstartable on a stock Mac.
CLIENT_PORT=5173

# The Docker server. Keep this in step with PORT above and with
# VITE_SERVER_PORT below - all three name the same API.
SERVER_PORT=5001

# What the browser calls in DEVELOPMENT only. apps/client/src/config/api.ts
# uses a relative path in a production build, where the server serves the
# client from its own origin, so this is unread there. Must match SERVER_PORT.
VITE_SERVER_PORT=5001

# ── Runtime ─────────────────────────────────────────────────────────────────

# development | test | production.
#
# An ALLOWLIST, not a flag: anything that is not exactly "development" or
# "test" is treated as production, so an unset or misspelled value fails
# closed. It is what decides whether JWT_SECRET may fall back to a built-in
# development value (apps/server/src/config/secret.ts); in production an unset,
# placeholder or short secret refuses the boot rather than starting insecurely.
NODE_ENV=development

# Email - used for invitations and password resets. SMTP_ENABLED=false leaves
# the rest of this block unread and disables those emails.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true only for implicit TLS on port 465. Port 587 uses STARTTLS and wants false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The From address recipients will see. Some providers reject a value that is
# not a verified sender on the account.
SMTP_FROM=EZPIPELINE <no-reply@example.com>
